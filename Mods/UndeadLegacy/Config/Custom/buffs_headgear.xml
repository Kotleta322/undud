	<!--<triggered_effect trigger="onSelfBuffStart" action="SetPartActive" part="NightVisionMesh" active="false"/>-->
	</effect_group>
	<effect_group name="OnStart">
		<requirement name="!IsFPV"/>
		<requirement name="!EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<triggered_effect trigger="onSelfBuffStart" action="SetPartActive" part="NightVisionMesh" active="true"/>
	</effect_group>
	<effect_group name="Valid Item">
		<requirement name="EquipmentHasTags,UndeadLegacy" slot="BiomeBadge" tags="nightvision"/>
		<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffNightvision_SelectView"/>
		<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffNightvision_Main"/>
	</effect_group>
	<effect_group name="Invalid Item">
		<requirement name="!EquipmentHasTags,UndeadLegacy" slot="BiomeBadge" tags="nightvision"/>
		<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffNightvision_Main"/>
	</effect_group></buff>

<buff name="buffNightvision_SelectView" icon="symbol_night_vision" icon_color="0,0,255" hidden="true">
	<stack_type value="replace"/>
	<duration value=".02"/>
	<effect_group name="Third Person View Default">
		<requirement name="!IsFPV"/>
		<requirement name="!EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<requirement name="EquipmentHasName,UndeadLegacy" slot="BiomeBadge" id="ulmArmorNightVision"/>
		<triggered_effect trigger="onSelfBuffFinish" action="AddPartTPV" part="NightVisionMesh" prefab="#Mods/UndeadLegacy/Resources/Subquake_Items.ulm?NVGMesh_Subquake_TPV"  parentTransform="Spotlight" localPos="0,0,0" localRot="0,0,0"/>
		<triggered_effect trigger="onSelfBuffFinish" action="AddPartTPV" part="LightSource" prefab="#Mods/UndeadLegacy/Resources/Subquake_Items.ulm?NVGLight_Subquake_TPV" parentTransform="Spotlight" localPos="0,0,0" localRot="0,0,0"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="LightSource" active="false"><requirement name="!HasBuff" buff="buffNightvision_Active"/></triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="LightSource" active="true"><requirement name="HasBuff" buff="buffNightvision_Active"/></triggered_effect>
	</effect_group>
	<effect_group name="Third Person View With Attachments">
		<requirement name="!IsFPV"/>
		<requirement name="EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<requirement name="EquipmentHasName,UndeadLegacy" slot="BiomeBadge" id="ulmArmorNightVision"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision" active="true"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision/lightSource" active="false">
			<requirement name="!HasBuff" buff="buffNightvision_Active"/></triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision/lightSource" active="true">
			<requirement name="HasBuff" buff="buffNightvision_Active"/></triggered_effect>
	</effect_group>
	<effect_group>
		<requirement name="HasBuff" buff="buffNightvision_Active"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightTPV" active="@!.IsFPV"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightFPV" active="@.IsFPV"/>
	</effect_group></buff>

<buff name="buffNightvision_Main" icon="symbol_night_vision" icon_color="0,255,0" hidden="true">
	<stack_type value="replace"/>
	<duration value="0"/>
	<update_rate value=".2"/>
	<effect_group name="General">
		<triggered_effect trigger="onSelfBuffRemove" action="RemovePreview,UndeadLegacy" part="DefaultNightvision"/>
	</effect_group>
	<effect_group name="OnUpdate">
		<requirement name="EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<triggered_effect trigger="onSelfBuffRemove" action="SetActiveInPreview,UndeadLegacy" parent="Head" transform="nightvision" active="false"/>
	</effect_group>
	<effect_group name="OnUpdate">
		<requirement name="CVarCompare" cvar=".IsPreviewVision" operation="Equals" value="1"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffNightvision_Preview"/>
	</effect_group>
	<effect_group name="OnRemove - Cleanup">
		<triggered_effect trigger="onSelfBuffRemove" action="RemovePart" part="CameraLight"/>
		<triggered_effect trigger="onSelfBuffRemove" action="RemovePart" part="NightVisionMesh"/>
		<triggered_effect trigger="onSelfBuffRemove" action="RemovePart" part="LightSource"/>
		<triggered_effect trigger="onSelfBuffRemove" action="SetPartActive" part="NightVisionMesh" active="false"/>
		<triggered_effect trigger="onSelfBuffRemove" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision/lightSource" active="false"/>
		<triggered_effect trigger="onSelfBuffRemove" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision" active="false"/>
	</effect_group></buff>

<buff name="buffNightvision_Preview" hidden="true">
	<stack_type value="effect"/>
	<duration value=".02"/>
	<effect_group>
		<requirement name="EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<triggered_effect trigger="onSelfBuffStart" action="SetActiveInPreview,UndeadLegacy" parent="Head" transform="nightvision" active="true"/>
		<triggered_effect trigger="onSelfBuffStart" action="RemovePreview,UndeadLegacy" part="DefaultNightvision"/>
	</effect_group>
	<effect_group>
		<requirement name="!EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		<triggered_effect trigger="onSelfBuffStart" action="AddPreview,UndeadLegacy" part="DefaultNightvision" prefab="#Mods/UndeadLegacy/Resources/Subquake_Items.ulm?NVGMesh_Subquake_TPV" parentTransform="Spotlight" localPos="0,0,0" localRot="0,0,0"/>
		<triggered_effect trigger="onSelfBuffStart" action="SetActiveInPreview,UndeadLegacy" parent="Head" transform="nightvision" active="false"/>
	</effect_group>
	<effect_group>
		<triggered_effect trigger="onSelfBuffStart" action="RemoveCVar" cvar=".IsPreviewVision"/>
	</effect_group></buff>
	
<buff name="buffNightvision_Start" hidden="true">
	<stack_type value="effect"/>
	<duration value=".1"/>
	<effect_group name="Check if have enough charges">
		<requirement name="ULM_Compare,UndeadLegacy" meta_key="ChargesUsed" operation="LT" passive_effect="ChargesMax" target="self" slot="BiomeBadge" tags="hasCharges"/>
		<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffNightvision_Start2"/>
	</effect_group>
	<effect_group name="Check if have enough charges">
		<requirement name="ULM_Compare,UndeadLegacy" meta_key="ChargesUsed" operation="GTE" passive_effect="ChargesMax" target="self" slot="BiomeBadge" tags="hasCharges"/>
		<triggered_effect trigger="onSelfBuffFinish" silent_on_equip="true" action="PlaySound" target="self" sound="ulmErrorSmall" play_in_head="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="ULM_SetItemActive,UndeadLegacy" slot="BiomeBadge" active="false"/>
	</effect_group></buff>

<buff name="buffNightvision_Start2" hidden="true">
	<stack_type value="effect"/>
	<duration value=".1"/>
	<effect_group>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightTPV" active="@!.IsFPV"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightFPV" active="@.IsFPV"/>
		<triggered_effect trigger="onSelfBuffFinish" action="ModifyScreenEffect" effect_name="NightVision" intensity="1" fade="0">
			<requirement name="IsLocalPlayer"/>
		</triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="CameraLight" active="@.IsFPV"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="LightSource" active="@!.IsFPV">
			<requirement name="!EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		</triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision/lightSource" active="@!.IsFPV">
			<requirement name="EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		</triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" silent_on_equip="true" action="PlaySound" target="self" sound="flashlight_toggle" play_in_head="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffNightvision_Active"/>
	</effect_group></buff>

<buff name="buffNightvision_Stop" hidden="true">
	<stack_type value="effect"/>
	<duration value=".1"/>
	<effect_group>
		<triggered_effect trigger="onSelfBuffFinish" silent_on_equip="true" action="PlaySound" target="self" sound="flashlight_toggle" play_in_head="false">
			<requirement name="HasBuff" buff="buffHeadlight_Active"/></triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="RemoveBuff" buff="buffNightvision_Active"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightTPV" active="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="HeadLightFPV" active="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="ModifyScreenEffect" effect_name="NightVision" intensity="0" fade="0">
			<requirement name="IsLocalPlayer"/>
		</triggered_effect>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="CameraLight" active="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetPartActive" part="LightSource" active="false"/>
		<triggered_effect trigger="onSelfBuffFinish" action="SetTransformActive,UndeadLegacy" parent="Head" transform="nightvision/lightSource" active="false">
			<requirement name="EquipmentHasTags,UndeadLegacy" slot="Head" tags="attachmentsIncluded"/>
		</triggered_effect>
	</effect_group></buff>

<buff name="buffNightvision_Active" name_key="ulmBuffNightvisionActive" icon="symbol_night_vision" icon_color="255,255,255">
	<stack_type value="effect"/>
	<duration value="0"/>
	<display_value value="ulmBatteryHelmetLight"/>
	<display_value_key value="{0:0}%"/>
	<effect_group name="General">
		<!-- 100 = 100%, duration = 30 min, ticks every 10 seconds = 180 ticks; 0.556 per tick to be subtracted -->
		<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$ulmBatteryHelmetLightTick" operation="set" value="0.556"/>
		<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$ulmBatteryHelmetLightEfficiency" operation="set" value="1"/>
		<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$ulmBatteryHelmetLightTick" operation="multiply" value="@$ulmBatteryHelmetLightEfficiency"/>

		<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="ulmBatteryHelmetLight" operation="set" value="1"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="ULM_Modify,UndeadLegacy" meta_key="ChargesUsed" tags="hasCharges" slot="BiomeBadge" operation="add" value="@$ulmBatteryHelmetLightTick" cvar_out="ulmBatteryHelmetLightInternal"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="ULM_Modify,UndeadLegacy" cvar="ulmBatteryHelmetLightInternal" operation="divide" value="ChargesMax" value_type="PassiveEffect"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="ulmBatteryHelmetLight" operation="subtract" value="@ulmBatteryHelmetLightInternal"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="ulmBatteryHelmetLight" operation="multiply" value="100"/>
		<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffNightvision_Stop">
			<requirement name="ULM_Compare,UndeadLegacy" meta_key="ChargesUsed" operation="GT" tags="hasCharges" target="self" slot="BiomeBadge" passive_effect="ChargesMax"/>
		</triggered_effect>
	</effect_group></buff>

</append>

