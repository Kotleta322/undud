<buff name="buffNightvision_Update" icon="symbol_night_vision" icon_color="0,0,255" hidden="true">
	<stack_type value="replace"/>
	<duration value=".02"/>
	<effect_group name="OnStart">
		<requirement name="IsFPV"/>
